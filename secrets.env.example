# Copy to secrets.env and fill in. Never commit secrets.env.
# Loaded by systemd (EnvironmentFile=) and by umdhub.core.config at startup.
# Pasted cookies / feed URLs do NOT go here — paste them in the Hub's
# /credentials page; they live in state.sqlite (chmod 600).

# Shared secret for the LAN login cookie (Phase A). Any long random string:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HUB_SHARED_SECRET=

# Piazza — its own account (not your UMD login). Leave blank to use a pasted cookie instead.
PIAZZA_EMAIL=
PIAZZA_PASSWORD=

# Email (IMAP). terpmail: Google Account -> Security -> 2-Step Verification -> App passwords.
# If UMD's admin blocks App Passwords, use a personal Gmail that receives forwarded course mail.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com

# Discord webhook for the refresh digest (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Headless auth for the extractor's `claude -p` calls. The interactive login's token on disk
# goes stale when another Claude Code client (desktop app) refreshes it; a long-lived token
# does not. Generate on this server with:  claude setup-token   (browser flow, then paste)
CLAUDE_CODE_OAUTH_TOKEN=

# Phase B only — Cloudflare Access (leave blank until the tunnel exists)
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
