{% extends "base.html.j2" %}
{% block title %}Keys · UMD Hub{% endblock %}
{% block content %}
<h1>Credentials</h1>
<p class="dim">Pasted values are stored only in this server's <code>state.sqlite</code> (mode 600). Leave a field blank and save to clear it. Passwords never go here — they live in <code>secrets.env</code>.</p>

{% for s in slots %}
<section class="cred {% if s.row and s.row.last_error %}bad{% elif s.row and s.row.last_ok_at %}good{% endif %}">
  <h2>{{ s.slot.label }}
    <span class="pill sm mono">{{ s.slot.source }}</span>
    {% if not s.enabled %}<span class="tag">disabled in config</span>{% endif %}
    {% if s.row %}
      {% if s.row.last_error %}<span class="tag bad">failing</span>{% elif s.row.last_ok_at %}<span class="tag good">ok</span>{% else %}<span class="tag">untested</span>{% endif %}
    {% else %}<span class="tag">not set</span>{% endif %}
  </h2>
  <p class="help">{{ s.slot.help }}</p>
  {% if s.row %}
  <div class="meta">current: <code>{{ s.masked }}</code> · saved {{ s.row.updated_at|et }}{% if s.row.last_ok_at %} · last ok {{ s.row.last_ok_at|et }}{% endif %}
    {% if s.row.last_error %}<div class="err">{{ s.row.last_error }}</div>{% endif %}</div>
  {% endif %}
  <form method="post" action="/credential" class="credform">
    <input type="hidden" name="source" value="{{ s.slot.source }}">
    <input type="hidden" name="name" value="{{ s.slot.name }}">
    {% if s.slot.multiline %}<textarea name="value" rows="3" placeholder="{{ s.slot.placeholder }}"></textarea>
    {% else %}<input name="value" placeholder="{{ s.slot.placeholder }}" autocomplete="off">{% endif %}
    <div class="actions">
      <button class="primary">save</button>
      <button formaction="/credential/{{ s.slot.source }}/test" formmethod="post" class="quiet" {% if not s.row %}disabled{% endif %}>test</button>
    </div>
  </form>
</section>
{% endfor %}

<section>
  <h2>secrets.env</h2>
  <table class="kv">
    {% for e in envs %}<tr><td class="mono">{{ e.name }}</td><td>{{ e.label }}</td><td>{% if e.set %}<span class="tag good">set</span>{% else %}<span class="tag">unset</span>{% endif %}</td></tr>{% endfor %}
  </table>
  <p class="dim">Edit <code>secrets.env</code> on the server, then <code>systemctl --user restart umdhub-app</code>.</p>
</section>

<section>
  <h2>Source health (72 h)</h2>
  <table class="kv">
    {% for name, h in health.items() %}
    <tr><td class="mono">{{ name }}</td><td>{% if h.ok %}<span class="tag good">ok</span>{% else %}<span class="tag bad">fail</span>{% endif %}</td><td class="dim">{{ h.runs }} runs, {{ h.failures }} failed{% if h.last_error %} — {{ h.last_error }}{% endif %}</td></tr>
    {% else %}<tr><td colspan="3" class="dim">no runs yet</td></tr>{% endfor %}
  </table>
</section>
{% endblock %}
